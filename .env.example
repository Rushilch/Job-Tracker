# MongoDB Configuration
MONGODB_URI=mongodb://mongodb:27017/job_search
MONGODB_DB_NAME=job_search

# Logging & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Service URLs (for inter-service internal communication)
APPLICATION_SERVICE_URL=http://application-service:8001
AUTH_SERVICE_URL=http://auth-service:8002
AGENT_SERVICE_URL=http://agent-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004

# Auth Configuration (Step 6 / Future)
JWT_SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External APIs & LLM Providers (for Agent Service)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
